{
  "manifest_version": 3,
  "name": "简辑千川账户桥接",
  "version": "1.0.0",
  "description": "通过当前 Chrome 登录态读取千川账户与计划。",
  "key": "",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://qianchuan.jinritemai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://qianchuan.jinritemai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
